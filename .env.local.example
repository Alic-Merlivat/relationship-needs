# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; this example file is not, so never put a real
# secret in here.

# --- Database (required for saving results) -------------------------------
# A Postgres connection string. Neon works well on Vercel and has a free
# tier: create a database, then copy its pooled connection string.
# Run drizzle/0000_init.sql against it once before first use.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Email (required for sending links) -----------------------------------
# Get a free API key at https://resend.com after signing up.
RESEND_API_KEY=re_your_api_key_here

# IMPORTANT: the default sender below is Resend's shared test address, which
# can ONLY deliver to the email address that owns your Resend account.
# Partner invitations to any other address will silently fail until you
# verify your own sending domain in the Resend dashboard and set this to an
# address at that domain.
# RESEND_FROM_EMAIL="My Relationship Needs <hello@yourdomain.com>"

# --- Links ----------------------------------------------------------------
# Absolute base URL used to build the links inside emails. Set this in
# production. It is deliberately not derived from the request's Host header,
# which an attacker can set. On Vercel this is inferred automatically.
# APP_URL=https://your-app.vercel.app
